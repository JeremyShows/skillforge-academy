{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillforge.local/schemas/skillforge-course-v1.schema.json",
  "title": "SkillForge Course Package V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest", "course"],
  "properties": {
    "manifest": {"$ref":"#/$defs/manifest"},
    "course": {"$ref":"#/$defs/course"},
    "lectures": {"$ref":"#/$defs/lectureCatalog"},
    "instructor": {"$ref":"#/$defs/instructor"},
    "academic": {"$ref":"#/$defs/academic"},
    "readings": {"type":"array","items":{"$ref":"#/$defs/reading"}},
    "assignments": {"type":"array","items":{"$ref":"#/$defs/assignment"}},
    "assessments": {"type":"array","items":{"$ref":"#/$defs/assessment"}},
    "remediation": {"type":"array","items":{"$ref":"#/$defs/remediation"}},
    "labs": {"$ref":"#/$defs/labCatalog"},
    "assets": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","kind","label","mediaType","byteLength"],"properties":{"id":{"$ref":"#/$defs/id"},"kind":{"enum":["image","diagram","text"]},"label":{"type":"string"},"mediaType":{"type":"string"},"byteLength":{"type":"integer","minimum":0},"extensionMetadata":{"$ref":"#/$defs/extensions"}}}},
    "migrations": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["fromCourseVersion","toCourseVersion","strategy","notes"],"properties":{"fromCourseVersion":{"$ref":"#/$defs/version"},"toCourseVersion":{"$ref":"#/$defs/version"},"strategy":{"enum":["preserve","reset-required","manual-review"]},"notes":{"type":"string"},"extensionMetadata":{"$ref":"#/$defs/extensions"}}}},
    "extensionMetadata": {"$ref":"#/$defs/extensions"}
  },
  "$defs": {
    "id": {"type":"string","pattern":"^[a-z0-9][a-z0-9._:-]{1,127}$"},
    "version": {"type":"string","pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
    "extensions": {"type":"object","additionalProperties":true},
    "location": {"type":"object","additionalProperties":false,"required":["unitId"],"properties":{"unitId":{"$ref":"#/$defs/id"},"lessonId":{"$ref":"#/$defs/id"},"activityId":{"$ref":"#/$defs/id"},"extensionMetadata":{"$ref":"#/$defs/extensions"}}},
    "manifest": {"type":"object","additionalProperties":false,"required":["format","formatVersion","packageId","packageVersion","courseId","courseVersion","contentVersion","title","description","capabilities"],"properties":{"format":{"const":"skillforge-course"},"formatVersion":{"const":1},"packageId":{"$ref":"#/$defs/id"},"packageVersion":{"$ref":"#/$defs/version"},"courseId":{"$ref":"#/$defs/id"},"courseVersion":{"$ref":"#/$defs/version"},"contentVersion":{"type":"string","minLength":1},"title":{"type":"string","minLength":1},"description":{"type":"string","minLength":1},"publisher":{"type":"string"},"authors":{"type":"array","items":{"type":"string"}},"license":{"type":"string"},"minimumSkillForgeVersion":{"type":"string"},"capabilities":{"type":"array","uniqueItems":true,"items":{"enum":["lecture-delivery","instructor","readings","assignments","assessments","remediation","deterministic-labs","executable-rust-lab","disposable-linux-runtime","network-simulation"]}},"visibilityMetadata":{"type":"object","additionalProperties":false,"properties":{"audience":{"enum":["public","private","local","enterprise"]},"builtIn":{"type":"boolean"},"extensionMetadata":{"$ref":"#/$defs/extensions"}}},"createdAt":{"type":"string"},"provenance":{"type":"object","additionalProperties":false,"properties":{"source":{"enum":["built-in","local-import","private-conformance"]},"sha256":{"type":"string"},"signatureStatus":{"enum":["unsigned","verified","unverified"]},"sourceRevision":{"type":"string"},"extensionMetadata":{"$ref":"#/$defs/extensions"}}},"extensionMetadata":{"$ref":"#/$defs/extensions"}}},
    "masteryCriterion": {"type":"object","additionalProperties":false,"required":["id","description","required","evidence"],"properties":{"id":{"$ref":"#/$defs/id"},"description":{"type":"string"},"required":{"type":"boolean"},"evidence":{"enum":["self-assessed","verified","assisted"]},"extensionMetadata":{"$ref":"#/$defs/extensions"}}},
    "activity": {"type":"object","additionalProperties":false,"required":["id","type","title","estimatedMinutes"],"properties":{"id":{"$ref":"#/$defs/id"},"type":{"type":"string","minLength":1},"title":{"type":"string"},"estimatedMinutes":{"type":"number","minimum":0},"body":{"type":"string"},"prompt":{"type":"string"},"objectiveIds":{"type":"array","items":{"type":"string"}},"conceptIds":{"type":"array","items":{"type":"string"}},"source":{"$ref":"#/$defs/location"},"required":{"type":"boolean"},"formal":{"type":"boolean"},"masteryRubric":{"type":"array","items":{"$ref":"#/$defs/masteryCriterion"}},"responseGuide":{"type":"array","items":{"type":"string"}},"scenario":{"type":"string"},"stages":{"type":"array"},"extensionMetadata":{"$ref":"#/$defs/extensions"}}},
    "lesson": {"type":"object","additionalProperties":false,"required":["id","title","summary","objectives","activities"],"properties":{"id":{"$ref":"#/$defs/id"},"title":{"type":"string"},"summary":{"type":"string"},"objectives":{"type":"array","items":{"type":"string"}},"activities":{"type":"array","items":{"$ref":"#/$defs/activity"}},"prerequisites":{"type":"array","items":{"type":"string"}},"concepts":{"type":"array","items":{"type":"string"}},"tags":{"type":"array","items":{"type":"string"}},"masteryRule":{"type":"object","additionalProperties":true},"extensionMetadata":{"$ref":"#/$defs/extensions"}}},
    "unit": {"type":"object","additionalProperties":false,"required":["id","title","description","lessons"],"properties":{"id":{"$ref":"#/$defs/id"},"title":{"type":"string"},"description":{"type":"string"},"lessons":{"type":"array","items":{"$ref":"#/$defs/lesson"}},"prerequisites":{"type":"array","items":{"type":"string"}},"masteryRequirements":{"type":"array","items":{"type":"string"}},"moduleAssessment":{"type":"object","additionalProperties":true},"extensionMetadata":{"$ref":"#/$defs/extensions"}}},
    "assessment": {"type":"object","additionalProperties":false,"required":["id","title","instructions","source","rubric"],"properties":{"id":{"$ref":"#/$defs/id"},"title":{"type":"string"},"instructions":{"type":"string"},"source":{"$ref":"#/$defs/location"},"rubric":{"type":"array","items":{"type":"string"}},"unitId":{"$ref":"#/$defs/id"},"kind":{"type":"string"},"sourceActivityIds":{"type":"array","items":{"$ref":"#/$defs/id"}},"required":{"type":"boolean"},"stages":{"type":"array"},"extensionMetadata":{"$ref":"#/$defs/extensions"}}},
    "course": {"type":"object","additionalProperties":false,"required":["id","title","description","units"],"properties":{"id":{"$ref":"#/$defs/id"},"title":{"type":"string"},"description":{"type":"string"},"subtitle":{"type":"string"},"subject":{"type":"string"},"level":{"enum":["beginner","intermediate","advanced"]},"audience":{"type":"array","items":{"type":"string"}},"type":{"enum":["certification","course","program","workshop"]},"outcomes":{"type":"array","items":{"type":"string"}},"estimatedTotalMinutes":{"type":"number"},"units":{"type":"array","items":{"$ref":"#/$defs/unit"}},"prerequisites":{"type":"array"},"placement":{"type":"object","additionalProperties":true},"capstone":{"$ref":"#/$defs/assessment"},"finalAssessment":{"$ref":"#/$defs/assessment"},"metadata":{"type":"object"},"extensionMetadata":{"$ref":"#/$defs/extensions"}}},
    "lectureSegment": {"type":"object","additionalProperties":false,"required":["id","kind","title","body"],"properties":{"id":{"$ref":"#/$defs/id"},"kind":{"type":"string"},"title":{"type":"string"},"body":{"type":"string"},"source":{"$ref":"#/$defs/location"},"lessonId":{"$ref":"#/$defs/id"},"activityId":{"$ref":"#/$defs/id"},"required":{"type":"boolean"},"authoredContent":{"type":"object"},"interaction":{"type":"object"},"references":{"type":"array"},"extensionMetadata":{"$ref":"#/$defs/extensions"}}},
    "lectureCatalog": {"type":"object","additionalProperties":false,"required":["version","lectures"],"properties":{"version":{"$ref":"#/$defs/version"},"lectures":{"type":"array"},"extensionMetadata":{"$ref":"#/$defs/extensions"}}},
    "instructor": {"type":"object","additionalProperties":false,"required":["id","displayRole","subjectScope","pedagogicalInstructions","allowedModes","fallbackLanguage"],"properties":{"id":{"$ref":"#/$defs/id"},"displayRole":{"type":"string"},"subjectScope":{"type":"string"},"pedagogicalInstructions":{"type":"array"},"allowedModes":{"type":"array"},"fallbackLanguage":{"type":"string"},"extensionMetadata":{"$ref":"#/$defs/extensions"}}},
    "reading": {"type":"object","additionalProperties":false,"required":["id","title","body","source"],"properties":{"id":{"$ref":"#/$defs/id"},"title":{"type":"string"},"body":{"type":"string"},"source":{"$ref":"#/$defs/location"},"unitId":{"$ref":"#/$defs/id"},"lessonId":{"$ref":"#/$defs/id"},"required":{"type":"boolean"},"extensionMetadata":{"$ref":"#/$defs/extensions"}}},
    "assignment": {"type":"object","additionalProperties":false,"required":["id","title","instructions","source"],"properties":{"id":{"$ref":"#/$defs/id"},"title":{"type":"string"},"instructions":{"type":"string"},"source":{"$ref":"#/$defs/location"},"unitId":{"$ref":"#/$defs/id"},"lessonId":{"$ref":"#/$defs/id"},"sourceActivityIds":{"type":"array"},"required":{"type":"boolean"},"extensionMetadata":{"$ref":"#/$defs/extensions"}}},
    "remediation": {"type":"object","additionalProperties":false,"required":["id","title","instructions","source"],"properties":{"id":{"$ref":"#/$defs/id"},"title":{"type":"string"},"instructions":{"type":"string"},"source":{"$ref":"#/$defs/location"},"unitId":{"$ref":"#/$defs/id"},"lessonId":{"$ref":"#/$defs/id"},"sourceActivityIds":{"type":"array"},"extensionMetadata":{"$ref":"#/$defs/extensions"}}},
    "academic": {"type":"object","additionalProperties":false,"required":["version","syllabus","units","readings","assignments","assessments"],"properties":{"version":{"type":"string"},"program":{"type":"object"},"syllabus":{"type":"object"},"units":{"type":"array"},"readings":{"type":"array","items":{"$ref":"#/$defs/reading"}},"assignments":{"type":"array","items":{"$ref":"#/$defs/assignment"}},"assessments":{"type":"array","items":{"$ref":"#/$defs/assessment"}},"completionRequirements":{"type":"object"},"extensionMetadata":{"$ref":"#/$defs/extensions"}}},
    "labCatalog": {"type":"object","additionalProperties":false,"required":["version","runtimeVersion","courseId","labs"],"properties":{"version":{"type":"string"},"runtimeVersion":{"type":"string"},"courseId":{"$ref":"#/$defs/id"},"labs":{"type":"array"},"extensionMetadata":{"$ref":"#/$defs/extensions"}}}
  }
}
